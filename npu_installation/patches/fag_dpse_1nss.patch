+// For 1NSS (pse broadcast over batch) dPSE is accumulated over batch by the vector core with GM
+// atomics, so dpse must be cleared before the main kernel work starts (each AIV core clears one slice,
+template <typename ChildClass, typename CubeBlockType, typename VecBlockType>
+__aicore__ inline void
+FlashAttentionScoreGradKernelBase<ChildClass, CubeBlockType, VecBlockType>::ZeroDpseForBroadcastPse()
+{
+    if (g_coreType != AIV) {
+        return;
+    }
+    if (tilingData->s1s2BNGS1S2BaseParams.pseShapeType != PSE_SHAPE_TYPE_1NSS ||
+        tilingData->s1s2BNGS1S2BaseParams.b <= 1) {
+        return;
+    }
+    uint64_t total = static_cast<uint64_t>(tilingData->s1s2BNGS1S2BaseParams.n2) *
+                     static_cast<uint64_t>(tilingData->s1s2BNGS1S2BaseParams.g) *
+                     static_cast<uint64_t>(tilingData->s1s2BNGS1S2BaseParams.s1) *
+                     static_cast<uint64_t>(tilingData->s1s2BNGS1S2BaseParams.s2);
+    if (total == 0) {
+        return;
+    }
+    dpseZeroGm.SetGlobalBuffer((__gm__ OUTDTYPE *)dpseAddr);
+    uint64_t blockNum = static_cast<uint64_t>(GetBlockNum());
+    if (blockNum == 0) {
+        blockNum = 1;
+    }
+    uint64_t idx = static_cast<uint64_t>(GetBlockIdx());
+    // Defensive: in a mix(1:2) kernel GetBlockIdx() and GetBlockNum() may not share the same semantics;
+    // if idx >= blockNum the offset would exceed total and write GM out of bounds. Folding it back
+    // keeps every write inside [0, total); clearing the same slice twice is harmless.
+    if (idx >= blockNum) {
+        idx = idx % blockNum;
+    }
+    uint64_t baseNum = total / blockNum;
+    uint64_t remNum = total % blockNum;
+    uint64_t cnt = baseNum + (idx < remNum ? 1UL : 0UL);
+    uint64_t off = idx * baseNum + (idx < remNum ? idx : remNum);
+    // Second guard: never step past total
+    if (off >= total) {
+        return;
+    }
+    if (off + cnt > total) {
+        cnt = total - off;
+    }
+    if (cnt > 0) {
+        InitOutput<OUTDTYPE>(dpseZeroGm[off], cnt, 0);
+    }
+}
