+    key: torch.Tensor,
+    value: torch.Tensor,
+    biases: list[torch.Tensor],
+) -> torch.Tensor:
+    """Ascend fused attention kernel (BNSD, PSE bias support).
+
+    Only valid on NPU; guarded by ``HAS_NPU`` at call sites.
+    """
+    if not HAS_NPU:
+        raise RuntimeError("npu_fusion_attention is only available on Ascend NPU")
+    if len(biases) == 0:
+        return torch_npu.npu_fusion_attention(
+            query, key, value, head_num=query.shape[1], input_layout="BNSD"
+        )[0]
+
+    # TriangleAttention supplies [mask_bias, triangle_bias]. Keep the mask
+    # separate so it does not have to be materialized into the BNSS PSE tensor.
+    if len(biases) == 2:
+        mask_bias, triangle_bias = biases
+        atten_mask = (mask_bias != 0).expand(-1, 1, query.shape[-2], -1)
+        return torch_npu.npu_fusion_attention(
+            query,
+            key,
+            value,
+            head_num=query.shape[1],
+            input_layout="BNSD",
+            pse=triangle_bias,
+            atten_mask=atten_mask,
+        )[0]
+
+    sum_bias = biases[0]
+    for bias in biases[1:]:
+        sum_bias = sum_bias + bias
+    expanded_biases = sum_bias.expand(-1, query.shape[1], query.shape[2], -1)
+    return torch_npu.npu_fusion_attention(
+        query,
+        key,
+        value,
+        head_num=query.shape[1],
+        input_layout="BNSD",
+        pse=expanded_biases,
+    )[0]
