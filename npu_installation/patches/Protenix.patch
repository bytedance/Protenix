+#!/bin/bash
+# NPU (Ascend) environment for Protenix.
+# Usage: source migrate_to_npu/env_npu.sh
+# Customize the *ROOT variables for your host.
+set -a
+ASCEND_HOME_PATH=${ASCEND_HOME_PATH:-/usr/local/Ascend/ascend-toolkit/}
+PROTENIX_ROOT_DIR=${PROTENIX_ROOT_DIR:-/modify/to/your/data_root_dir}
+PYTHONPATH=${PYTHONPATH}:$(pwd)
+set +a
+source "$ASCEND_HOME_PATH/set_env.sh"
+echo "[env_npu] ASCEND_HOME_PATH=$ASCEND_HOME_PATH"
+echo "[env_npu] PROTENIX_ROOT_DIR=$PROTENIX_ROOT_DIR"
+echo "[env_npu] PYTHONPATH=$PYTHONPATH"
\ No newline at end of file
